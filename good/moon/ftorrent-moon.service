# The Go service, ftorrent-moon, built on the box from go-moon/ by deploy.py and installed at /usr/local/bin/ftorrent-moon. It listens on the loopback address alone, and Caddy proxies the three names to it. The hardening is the main server's compose block for its Go reflector written as systemd directives, the same set coturn's drop-in carries, less the state folder coturn needs and the netlink socket it opens; this program keeps no state and enumerates no interfaces.
[Unit]
Description=the Go service of moon.ftorrent.com: the reflector, the poke, and the dial
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ftorrent-moon
Restart=on-failure
# A user made for this run and gone after it, with no home, no login, and no file of its own anywhere.
DynamicUser=yes
# The filesystem read-only throughout, a private /tmp, and no view of home folders, devices, or other processes.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# No capabilities, and no way to gain any: 8100 is above the privileged ports.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
# Sockets of the two internet families only, and the system calls an ordinary service uses; anything else fails with a permission error rather than killing the process.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# The compose file's limits for the main server's reflector: 64 MB, a quarter of a core, 32 tasks.
MemoryMax=64M
CPUQuota=25%
TasksMax=32

[Install]
WantedBy=multi-user.target
