# The three network namespaces moon's peers run in, made at boot by namespaces.py, which says what each one is. deploy.py installs the script at /usr/local/bin/namespaces.py and this unit, and enables it; it runs as root with no hardening, since making interfaces and namespaces is exactly what the hardening elsewhere takes away. A comment here is a line of its own, starting with #.
[Unit]
Description=the three network namespaces moon's peers punch through, cone, symmetric, and firewall
#after the network is up, since the firewall namespace's address comes from moon's /64
After=network-online.target
Wants=network-online.target

[Service]
#the script runs once, and the unit counts as active from then on, so the namespaces stay until it's stopped
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/namespaces.py up
ExecStop=/usr/local/bin/namespaces.py down

[Install]
#made at every boot, with the rest of the services that run at startup
WantedBy=multi-user.target
