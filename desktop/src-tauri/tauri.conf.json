{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ftorrent",
	"version": "0.1.0",
	"identifier": "com.ftorrent.ftorrent",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm vite-build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:"
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"app",
			"dmg",
			"nsis",
			"deb"
		],
		"publisher": "ftorrent",
		"homepage": "https://ftorrent.com/",
		"copyright": "Copyright © 2026 ftorrent",
		"license": "GPL-3.0-only",
		"shortDescription": "Next-generation client for the decentralized web",
		"longDescription": "Next-generation client for the decentralized web. One engine holds desktop peers and browser peers in a single swarm, so a torrent reaches everyone who can open a web page. Free software under the GPL.",
		"category": "Utility",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/mac/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../engine/dist/ftorrent-engine": "ftorrent-engine",
			"icons/tile/ftorrent.VisualElementsManifest.xml": "ftorrent.VisualElementsManifest.xml",
			"icons/tile/tile-medium.png": "tile-medium.png",
			"icons/tile/tile-small.png": "tile-small.png",
			"icons/torrent.ico": "torrent.ico"
		},
		"linux": {
			"deb": {"desktopTemplate": "ftorrent.desktop.hbs"},
			"rpm": {"desktopTemplate": "ftorrent.desktop.hbs"}
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico",
				"uninstallerIcon": "icons/icon.ico"
			}
		},
		"macOS": {
			"minimumSystemVersion": "15.0",
			"signingIdentity": "-"
		}
	}
}
