# The toolchain that wraps ftorrent's x86-64 .deb into a .flatpak.
#
# A Flatpak is less another package format than a different bargain: the application ships with its libraries and runs in a sandbox, so it does not care what the host has installed. That is what makes it the one package here that reaches SteamOS and Bazzite, whose root filesystems are read-only or atomic and where a .deb or an .rpm cannot be installed at all.
#
# This image is the odd one out. It needs no Rust, no Node, and no uv, because it consumes the .deb the Tauri image already made, engine and all, rather than compiling anything; and no flatpak-builder either, for the reason inside-flatpak.sh sets out. What it does need is the GNOME runtime and SDK to build against, and those are some five gigabytes, which is exactly why they are installed here, in the durable layer, rather than fetched again by every ephemeral build. It is by a wide margin the largest of the three images.
FROM debian:12-slim

# flatpak for the build commands, binutils for ar, which unpacks the .deb, and ca-certificates so flatpak can reach Flathub below.
RUN apt-get update && apt-get install -y --no-install-recommends \
      flatpak ca-certificates binutils xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Flathub is contacted here for one thing only: the runtime to build against. That is fetching a dependency, the way cargo fetches from crates.io, and not an account, a submission, or a listing; publishing to Flathub is a separate decision this pipeline does not make.
#
# This version needs watching, in a way the other pins in this folder do not. The runtime supplies WebKitGTK, the engine that draws ftorrent's window, so an end-of-life runtime means shipping an unpatched browser inside a sandbox whose whole purpose is containment. GNOME 49 carries libwebkit2gtk-4.1, which Tauri 2 links; newer runtimes will eventually drop it for webkitgtk-6.0, and that drop is a Tauri migration rather than a number to bump here.
ARG GNOME_VERSION=49
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
 && flatpak install -y --noninteractive flathub \
      "org.gnome.Platform//${GNOME_VERSION}" "org.gnome.Sdk//${GNOME_VERSION}"

# No script is baked in. What a container does is mounted at run time by build.js, because an image here is the toolchain and nothing else: editing a build step should not mean rebuilding one.
