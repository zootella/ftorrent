{
	"name": "desktop",
	"description": "Next generation desktop BitTorrent and WebTorrent client, built with Tauri",
	"homepage": "https://ftorrent.com/",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"local": "tauri dev",
		"engine": "cd engine && uv sync --frozen && uv run --frozen pyinstaller --noconfirm --clean ftorrent-engine.spec",
		"linux": "node linux/build.js build",
		"linux-images": "node linux/build.js images",
		"linux-stage": "node linux/build.js stage",
		"linux-check": "node linux/build.js check",
		"build-binary": "tauri build --no-bundle",
		"build-app": "tauri build --bundles app",
		"build-dmg": "tauri build",
		"build": "tauri build",
		"app": "open src-tauri/target/release/bundle/macos/ftorrent.app",
		"win": "start src-tauri/target/release/ftorrent.exe",
		"dev": "vite",
		"vite-build": "vite build",
		"preview": "vite preview",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"pinia": "^4.0.3",
		"vue": "^3.5.41",
		"vue-router": "^5.2.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@vitejs/plugin-vue": "^6.0.8",
		"tailwindcss": "^4.3.3",
		"vite": "^8.2.2"
	}
}
